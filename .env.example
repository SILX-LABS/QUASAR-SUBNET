# Shared identity
QUASAR_NETWORK=test
QUASAR_NETUID=508
QUASAR_WALLET_PATH=~/.bittensor/wallets
QUASAR_WALLET_NAME=<wallet>
QUASAR_HOTKEY_NAME=<hotkey>

# Shared bucket
QUASAR_S3_BUCKET=<bucket>
QUASAR_S3_REGION=us-east-1
QUASAR_S3_ENDPOINT_URL=

# Miner/validator public metadata mode.
# Private artifacts move through encrypted presigned grants.
# Do not set AWS keys on public miner or validator hosts.
# QUASAR_S3_ANONYMOUS=true

# Orchestrator-only bucket credentials.
# Leave unset on public miner and validator hosts.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Validator/miner trust anchor.
# Required by scripts/run_validator.sh and miner run commands.
QUASAR_OWNER_IDENTITY=<orchestrator-hotkey>

# Orchestrator-only checkpoint input.
# Initial checkpoint must include quasar_parameter_contract.json or equivalent manifest metadata.
QUASAR_CHECKPOINT_MANIFEST_URI=<checkpoint-manifest-uri>

# Orchestrator-only merge cutoff.
# After the first valid receipt reaches merge quorum, keep the round open long enough
# for normal upload/validation lag before taking the merge snapshot.
QUASAR_ROUND_MERGE_MIN_GRACE_SEC=900
QUASAR_ROUND_MERGE_MAX_GRACE_SEC=1800

# Orchestrator-only validation-job targets.
# Merge authority defaults to the orchestrator signer identity. Set
# QUASAR_MERGE_VALIDATOR_HOTKEYS only if you intentionally want a merge committee.
QUASAR_VALIDATOR_HOTKEYS=<validator-hotkey-a>,<validator-hotkey-b>
# QUASAR_VALIDATION_TARGET_HOTKEYS=<validator-hotkey-a>,<validator-hotkey-b>
# QUASAR_MERGE_VALIDATOR_HOTKEYS=<canonical-merge-validator-hotkey>

# Dashboard backend.
# Serves sanitized dashboard JSON from public orchestrator bucket state.
QUASAR_DASHBOARD_INTERVAL_SEC=15
QUASAR_DASHBOARD_PUBLISH_S3=false
QUASAR_DASHBOARD_RATE_LIMIT_REQUESTS=120
QUASAR_DASHBOARD_RATE_LIMIT_WINDOW_SEC=60
QUASAR_DASHBOARD_CORS_ORIGINS=*
# QUASAR_DASHBOARD_URI=s3://<bucket>/public/dashboard.json

# Optional W&B telemetry.
# WANDB_API_KEY=<wandb-token>
QUASAR_WANDB_PROJECT=quasar-incentive
# QUASAR_WANDB_ENTITY=<wandb-entity>
# QUASAR_ORCHESTRATOR_WANDB_PROJECT=quasar-incentive
# QUASAR_ORCHESTRATOR_WANDB_RUN_NAME=<run-name>

# Validator weight publishing.
# Re-submit unchanged positive weights periodically so a quiet run does not leave stale chain state.
QUASAR_WEIGHT_REFRESH_SEC=1800

# Optional install behavior.
QUASAR_PREPARE_MODEL_CODE=1
