FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/api \
    QUASAR_STATE_DIR=/app/state

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements-api.txt

COPY api ./api
COPY config ./config
COPY eval ./eval
COPY scripts/validator/__init__.py ./scripts/validator/__init__.py
COPY scripts/validator/composite.py ./scripts/validator/composite.py
COPY scripts/validator/policy.py ./scripts/validator/policy.py
COPY scripts/validator/single_eval.py ./scripts/validator/single_eval.py

RUN mkdir -p /app/state

EXPOSE 3710

CMD ["sh", "-c", "python -m uvicorn api.server:app --host 0.0.0.0 --port ${PORT:-3710} --log-level info"]
